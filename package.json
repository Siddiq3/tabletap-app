{
  "name": "tabletap-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "demo": "EXPO_PUBLIC_DEMO_MODE=true expo start --port 8082",
    "demo:web": "EXPO_PUBLIC_DEMO_MODE=true expo start --web --port 8082",
    "export:demo": "EXPO_PUBLIC_DEMO_MODE=true expo export --platform all",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "2.119.0",
    "expo": "^58.0.23",
    "expo-audio": "~58.0.11",
    "expo-constants": "~58.0.15",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "2.0.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@types/node": "^24.19.2",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "glob": "^14.0.4",
    "minimatch": "^11.0.5",
    "react-dom": "19.3.0"
  }
}
